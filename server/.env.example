# Адрес сервера: домен, который указывает на IP вашей виртуальной машины
DOMAIN=journal.example.kz
# С каких страниц можно обращаться к серверу, кроме него самого (через запятую).
# null — журнал, открытый как файл на компьютере. Приложение на GitHub Pages — https://aukeev.github.io
ALLOWED_ORIGINS=https://aukeev.github.io,null
# Сколько дней хранить ежедневные резервные копии
BACKUP_KEEP_DAYS=30
# Через сколько дней без работы нужно войти заново
SESSION_DAYS=30
